---
// src/components/Header.astro
// 获取当前路径，用于高亮导航
const currentPath = Astro.url.pathname;
---

<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50">
  <!-- 核心容器 -->
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    
    <!-- 左侧：Logo区域 (完全保留) -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img 
        src="/images/logo.png" 
        alt="永思洞察 Logo" 
        class="h-[22px] w-auto object-contain" 
      />
    </a>

    <!-- 中间：导航菜单 (保留原样，仅增加移动端隐藏类) -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/" class={`font-medium transition-colors text-[15px] ${currentPath === '/' ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}`}>首页</a>
      <a href="/blog/" class={`font-medium transition-colors text-[15px] ${currentPath.startsWith('/blog') ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}`}>洞察中心</a>
      <a href="/solutions/" class={`font-medium transition-colors text-[15px] ${currentPath.startsWith('/solutions') ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}`}>解决方案</a>
      <a href="/innovation-lab/" class={`font-medium transition-colors text-[15px] ${currentPath.startsWith('/innovation-lab') ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}`}>创新实验室</a>
      <a href="/about/" class={`font-medium transition-colors text-[15px] ${currentPath.startsWith('/about') ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}`}>关于我们</a>
    </nav>

    <!-- 右侧：功能区域 (保留原样，仅增加移动端隐藏类) -->
    <div class="flex items-center gap-6">
      <a href="/contact/" class="hidden lg:block text-gray-600 hover:text-blue-600 font-medium text-[15px]">联系我们</a>
      <div class="h-4 w-px bg-gray-300 hidden lg:block"></div>
      <a href="/login/" class="text-gray-600 hover:text-blue-600 font-medium text-[15px]">登录</a>
      
      <!-- 语言切换图标 (完全保留) -->
      <a href="/about-en" class="text-gray-600 hover:text-blue-600 flex items-center justify-center transition-colors cursor-pointer" aria-label="切换语言">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>
    </div>

    <!-- 移动端：汉堡菜单按钮 (新增) -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-600 focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- 移动端：下拉菜单 (新增) -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg">
    <div class="px-6 py-4 space-y-3">
      <a href="/" class={`block px-3 py-2 rounded-md text-base font-medium ${currentPath === '/' ? 'bg-gray-50 text-blue-600' : 'text-gray-600 hover:bg-gray-50'}`}>首页</a>
      <a href="/blog/" class={`block px-3 py-2 rounded-md text-base font-medium ${currentPath.startsWith('/blog') ? 'bg-gray-50 text-blue-600' : 'text-gray-600 hover:bg-gray-50'}`}>洞察中心</a>
      <a href="/solutions/" class={`block px-3 py-2 rounded-md text-base font-medium ${currentPath.startsWith('/solutions') ? 'bg-gray-50 text-blue-600' : 'text-gray-600 hover:bg-gray-50'}`}>解决方案</a>
      <a href="/cases/" class={`block px-3 py-2 rounded-md text-base font-medium ${currentPath.startsWith('/cases') ? 'bg-gray-50 text-blue-600' : 'text-gray-600 hover:bg-gray-50'}`}>经典案例</a>
      <a href="/about/" class={`block px-3 py-2 rounded-md text-base font-medium ${currentPath.startsWith('/about') ? 'bg-gray-50 text-blue-600' : 'text-gray-600 hover:bg-gray-50'}`}>关于我们</a>
      <a href="/contact/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:bg-gray-50">联系我们</a>
    </div>
  </div>
</header>

<!-- 移动端菜单交互脚本 (新增) -->
<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu.classList.toggle('hidden');
  });
</script>