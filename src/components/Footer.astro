---
// 顶部代码块：定义当前年份
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-50 dark:bg-gray-900 border-t border-slate-200 dark:border-slate-800 py-12">
  <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
    
    <!-- 左侧：版权信息 -->
    <div class="text-center md:text-left">
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Copyright &copy; {currentYear} Usearch Inc. 北京永思管理咨询有限公司保留所有权利
      </p>
    </div>

    <!-- 右侧：备案号 (带链接) -->
    <div class="text-center md:text-right">
      <a 
        href="https://beian.miit.gov.cn/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-sm text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors"
      >
        京ICP备1201652号
      </a>
    </div>

  </div>
</footer>