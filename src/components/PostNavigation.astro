---
// src/components/PostNavigation.astro
interface Props {
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { prev, next } = Astro.props;
---

{
  // 只有当 prev 或 next 存在时才渲染整个导航区域
  (prev || next) && (
    <nav class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- 左侧：上一篇 -->
      <div class="flex flex-col">
        {prev ? (
          <a
            href={`/blog/${prev.slug}/`}
            class="group flex flex-col p-5 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-indigo-500 dark:hover:border-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all duration-300 shadow-sm hover:shadow-md h-full justify-center"
          >
            <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2 flex items-center gap-1">
              ← 上一篇
            </span>
            <span class="text-lg font-medium text-gray-900 dark:text-gray-100 group-hover:text-indigo-700 dark:group-hover:text-indigo-300 line-clamp-2">
              {prev.title}
            </span>
          </a>
        ) : (
          /* 占位符：保持布局平衡，或者你可以选择留空 */
          <div class="hidden md:block p-5 rounded-xl border border-dashed border-gray-200 dark:border-gray-800 opacity-50 h-full flex items-center justify-center">
             <span class="text-sm text-gray-400">已经是第一篇了</span>
          </div>
        )}
      </div>

      <!-- 右侧：下一篇 -->
      <div class="flex flex-col md:items-end">
        {next ? (
          <a
            href={`/blog/${next.slug}/`}
            class="group flex flex-col p-5 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-indigo-500 dark:hover:border-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all duration-300 shadow-sm hover:shadow-md h-full justify-center text-right"
          >
            <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2 flex items-center justify-end gap-1">
              下一篇 →
            </span>
            <span class="text-lg font-medium text-gray-900 dark:text-gray-100 group-hover:text-indigo-700 dark:group-hover:text-indigo-300 line-clamp-2">
              {next.title}
            </span>
          </a>
        ) : (
          /* 占位符 */
          <div class="hidden md:block p-5 rounded-xl border border-dashed border-gray-200 dark:border-gray-800 opacity-50 h-full flex items-center justify-center">
             <span class="text-sm text-gray-400">已经是最新一篇了</span>
          </div>
        )}
      </div>

    </nav>
  )
}