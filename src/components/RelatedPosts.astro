---
// src/components/RelatedPosts.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  // 接收过滤后的文章列表
  posts: CollectionEntry<'blog'>[];
  currentSlug: string; // 当前文章 slug，用于排除自己
}

const { posts, currentSlug } = Astro.props;

// 简单的洗牌算法，让推荐不总是固定的（可选）
function shuffle(array: any[]) {
  return array.sort(() => Math.random() - 0.5);
}

// 逻辑：排除当前文章 -> 随机打乱 -> 取前4篇
const relatedPosts = shuffle(posts.filter(p => p.id !== currentSlug)).slice(0, 4);

// 如果没有文章可推荐，就不渲染
if (relatedPosts.length === 0) return null;
---

<div class="mt-16 pt-10 border-t border-gray-200 dark:border-gray-800">
  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 pl-1">
    相关推荐
  </h3>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {relatedPosts.map((post) => (
      <a
        href={`/blog/${post.id}/`}
        class="group block p-5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-md transition-all duration-300"
      >
        {/* 标题 */}
        <h4 class="text-base font-semibold text-gray-800 dark:text-gray-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 line-clamp-2 mb-2 leading-snug">
          {post.data.title}
        </h4>
        
        {/* 元数据：分类 · 作者 · 日期 */}
        <div class="flex flex-wrap items-center text-xs text-gray-500 dark:text-gray-400 gap-2">
          {post.data.category && (
            <span class="font-medium text-indigo-600/80 dark:text-indigo-400/80">
              {post.data.category}
            </span>
          )}
          
          {/* 分隔点 */}
          <span>·</span>
          
          {post.data.author && <span>{post.data.author}</span>}
          
          {/* 如果有作者和日期，显示分隔点 */}
          {(post.data.author && post.data.pubDate) && <span>·</span>}
          
          {post.data.pubDate && (
            <time datetime={String(post.data.pubDate)}>
              {new Date(post.data.pubDate).toISOString().split('T')[0]}
            </time>
          )}
        </div>
      </a>
    ))}
  </div>
</div>