---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`登录 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800">
    <Header />
    <main class="flex-1 flex items-center justify-center px-6 py-24">
      <div class="max-w-md w-full bg-white rounded-2xl shadow-sm border border-slate-100 p-8 text-center">
        <h1 class="text-2xl font-bold text-slate-900 mb-4">登录</h1>
        <p class="text-slate-600 mb-8">
          会员登录功能正在开发中，敬请期待。
        </p>
        <a
          href="/"
          class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
        >
          返回首页
        </a>
      </div>
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
