---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

// 定义页面专属的靛青色主题色 (岩灰紫)
const THEME_COLOR = '#4338ca'; 
const THEME_BG_LIGHT = '#eef2ff'; 
const THEME_TEXT = '#4338ca'; 

// 核心卖点数据 (3大真实)
const features = [
  {
    title: '真懂用户',
    desc: '不只是问卷，而是48小时深度访谈+影子跟踪，挖出用户自己都不知道的真实动机。',
    highlight: '48h'
  },
  {
    title: '真追对手',
    desc: '不是百度二手资料，而是实地走访+经销商深访，拿到对手渠道政策的第一手情报。',
    highlight: '实地'
  },
  {
    title: '真看市场',
    desc: '7天完成3城32店神秘顾客+200样本访谈，比客户自己更懂终端。',
    highlight: '7天'
  }
];

// 具体服务清单
const services = [
  '消费者洞察', '新品创新研究', '品牌健康度追踪', '广告效果评估',
  '用户体验诊断', '渠道零售普查', '满意度与NPS测量'
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`市场调查 - ${SITE_TITLE}`} description="看清战场，才敢开枪。提供深度访谈、实地走访与神秘顾客等一手市场调查服务。" />
    <style>
      /* 简单的过渡动画 */
      .fade-in-up { animation: fadeInUp 0.6s ease-out forwards; opacity: 0; transform: translateY(20px); }
      @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
      .delay-100 { animation-delay: 0.1s; }
      .delay-200 { animation-delay: 0.2s; }
      .delay-300 { animation-delay: 0.3s; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 dark:bg-gray-950 dark:text-gray-100 font-sans">
    
    <!-- 顶部色条：身份标识 -->
    <div class="w-full h-1.5" style={`background-color: ${THEME_COLOR}`}></div>

    <Header />

    <main class="flex-1 w-full">
      
      <!-- 1. Hero Section: 核心主张 -->
      <section class="relative overflow-hidden bg-white dark:bg-gray-900 border-b border-slate-100 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
          <div class="max-w-3xl fade-in-up">
            <span class="inline-block py-1 px-3 rounded-full text-xs font-bold tracking-wider uppercase mb-4" 
                  style={`background-color: ${THEME_BG_LIGHT}; color: ${THEME_TEXT}; border: 1px solid ${THEME_COLOR}20`}>
              MARKET RESEARCH SOLUTION
            </span>
            <h1 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6 leading-tight">
              市场调查：<br class="md:hidden">看清战场，才敢开枪
            </h1>
            <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed">
              拒绝二手资料与表面问卷。我们通过实地走访与深度访谈，为您提供比客户自己更懂终端的一手情报。
            </p>
          </div>
        </div>
        <!-- 背景装饰 -->
        <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 rounded-full opacity-5 blur-3xl" style={`background-color: ${THEME_COLOR}`}></div>
      </section>

      <!-- 2. Core Features: 三大差异化优势 -->
      <section class="py-16 md:py-24 bg-slate-50 dark:bg-gray-950">
        <div class="max-w-7xl mx-auto px-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {features.map((feature, index) => (
              <div class={`bg-white dark:bg-gray-900 p-8 rounded-xl shadow-sm border border-slate-100 dark:border-gray-800 hover:shadow-md transition-shadow fade-in-up delay-${(index + 1) * 100}`}>
                <div class="flex items-baseline justify-between mb-4">
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white">{feature.title}</h3>
                  <span class="text-3xl font-black opacity-10" style={`color: ${THEME_COLOR}`}>{feature.highlight}</span>
                </div>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                  {feature.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. Services List: 具体服务矩阵 (模块化卡片) -->
      <section class="py-16 md:py-24 bg-white dark:bg-gray-900">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-12 md:mb-16 fade-in-up">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight">全链路市场研究能力</h2>
            <p class="text-lg text-slate-500 dark:text-slate-400 font-medium">从消费者心智洞察，到终端渠道诊断</p>
          </div>
          
          <!-- 服务网格 (移动端双列，桌面端四列) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 fade-in-up delay-200">
            
            <!-- 1. 消费者洞察 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300" style={`background-color: ${THEME_BG_LIGHT}`}>
                <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">消费者洞察</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">深挖用户真实动机与未被满足的痛点。</p>
            </div>

            <!-- 2. 新品创新研究 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300" style={`background-color: ${THEME_BG_LIGHT}`}>
                <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">新品创新研究</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">验证产品概念，降低上市失败风险。</p>
            </div>

            <!-- 3. 品牌健康度追踪 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300" style={`background-color: ${THEME_BG_LIGHT}`}>
                <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">品牌健康度追踪</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">持续监测品牌认知与美誉度变化。</p>
            </div>

            <!-- 4. 广告效果评估 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300" style={`background-color: ${THEME_BG_LIGHT}`}>
                <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">广告效果评估</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">量化营销投入产出，优化传播策略。</p>
            </div>

            <!-- 5. 用户体验诊断 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300" style={`background-color: ${THEME_BG_LIGHT}`}>
                <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">用户体验诊断</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">发现交互与流程中的摩擦点。</p>
            </div>

            <!-- 6. 渠道零售普查 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300" style={`background-color: ${THEME_BG_LIGHT}`}>
                <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">渠道零售普查</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">掌握终端铺货率与陈列表现。</p>
            </div>

            <!-- 7. 满意度与NPS测量 -->
            <div class="group bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-gray-800 flex flex-col h-full md:col-span-2 lg:col-span-2">
              <div class="flex items-start">
                 <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 mr-6 group-hover:scale-110 transition-transform duration-300 flex-shrink-0" style={`background-color: ${THEME_BG_LIGHT}`}>
                  <svg class="w-6 h-6" style={`color: ${THEME_TEXT}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">满意度与NPS测量</h3>
                  <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">建立标准化的客户体验衡量指标，精准定位服务短板与忠诚用户驱动力。</p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

            <!-- CTA Section -->
      <section class="py-16 bg-white dark:bg-gray-900 text-center">
        <div class="max-w-3xl mx-auto px-6 fade-in-up delay-300">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">准备好看清您的市场战场了吗？</h2>
          <p class="text-slate-600 dark:text-slate-400 mb-8">我们的市场研究专家团队将在24小时内与您联系。</p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 text-base font-medium text-white rounded-lg shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5" style={`background-color: ${THEME_COLOR}`}>
            预约专家诊断
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </section>

    </main>

    <Footer />
    <BackToTop />
  </body>
</html>