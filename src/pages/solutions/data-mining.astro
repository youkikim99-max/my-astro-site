---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

// 定义页面专属的深海蓝主题色
const THEME_COLOR = '#1e3a8a'; // 对应之前的 border-t-[#1e3a8a]
const THEME_BG_LIGHT = '#eff6ff'; // 对应之前的 bg-[#eff6ff]
const THEME_TEXT = '#1e40af'; // 对应之前的 text-[#1e40af]

// 核心卖点数据
const features = [
  {
    title: '三源交叉验证',
    desc: '你的CRM + 行业数据 + 500万条舆情，三角互证，洞察才稳。',
    highlight: '3源'
  },
  {
    title: '算法实战落地',
    desc: 'AI预测+业务规则结合，模型准确率92%以上，且业务团队看得懂。',
    highlight: '92%'
  },
  {
    title: '7天极速交付',
    desc: '从提需求到交付洞察，7天必出活，决策不等人。',
    highlight: '7天'
  }
];

// 具体服务清单
const services = [
  '用户画像与细分', '销售预测与预警', '流失挽回模型', '价格弹性分析',
  '舆情与口碑洞察', '供应链优化', '文本挖掘与标签体系'
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`数据挖掘 - ${SITE_TITLE}`} description="看透本质，才能破局。提供三源交叉验证、AI预测与7天极速交付的数据挖掘服务。" />
    <style>
      /* 简单的过渡动画 */
      .fade-in-up { animation: fadeInUp 0.6s ease-out forwards; opacity: 0; transform: translateY(20px); }
      @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
      .delay-100 { animation-delay: 0.1s; }
      .delay-200 { animation-delay: 0.2s; }
      .delay-300 { animation-delay: 0.3s; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 dark:bg-gray-950 dark:text-gray-100 font-sans">
    
    <!-- 顶部色条：身份标识 -->
    <div class="w-full h-1.5" style={`background-color: ${THEME_COLOR}`}></div>

    <Header />

    <main class="flex-1 w-full">
      
      <!-- 1. Hero Section: 核心主张 -->
      <section class="relative overflow-hidden bg-white dark:bg-gray-900 border-b border-slate-100 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
          <div class="max-w-3xl fade-in-up">
            <span class="inline-block py-1 px-3 rounded-full text-xs font-bold tracking-wider uppercase mb-4" 
                  style={`background-color: ${THEME_BG_LIGHT}; color: ${THEME_TEXT}; border: 1px solid ${THEME_COLOR}20`}>
              DATA MINING SOLUTION
            </span>
            <h1 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6 leading-tight">
              数据挖掘：<br class="md:hidden">看透本质，才能破局
            </h1>
            <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed">
              拒绝盲目决策。我们通过三源交叉验证与AI实战算法，在7天内为你提供可落地的增长洞察。
            </p>
          </div>
        </div>
        <!-- 背景装饰（可选） -->
        <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 rounded-full opacity-5 blur-3xl" style={`background-color: ${THEME_COLOR}`}></div>
      </section>

      <!-- 2. Core Features: 三大差异化优势 -->
      <section class="py-16 md:py-24 bg-slate-50 dark:bg-gray-950">
        <div class="max-w-7xl mx-auto px-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {features.map((feature, index) => (
              <div class={`bg-white dark:bg-gray-900 p-8 rounded-xl shadow-sm border border-slate-100 dark:border-gray-800 hover:shadow-md transition-shadow fade-in-up delay-${(index + 1) * 100}`}>
                <div class="flex items-baseline justify-between mb-4">
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white">{feature.title}</h3>
                  <span class="text-3xl font-black opacity-10" style={`color: ${THEME_COLOR}`}>{feature.highlight}</span>
                </div>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                  {feature.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

          <!-- 第三屏：具体服务清单 (重构版 - 模块化卡片风格) -->
      <section class="py-16 md:py-24 bg-slate-50">
        <div class="max-w-7xl mx-auto px-6">
          
          <!-- 标题区域 -->
          <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 tracking-tight">全链路数据服务能力</h2>
            <p class="text-lg text-slate-500 font-medium">从底层标签体系构建，到顶层战略预测模型</p>
          </div>

          <!-- 服务网格 (移动端双列，桌面端四列) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <!-- 1. 用户画像 -->
            <div class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 flex flex-col h-full">
              <!-- 图标容器 (带极浅底色) -->
              <div class="w-12 h-12 rounded-lg bg-[#eff6ff] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">用户画像与细分</h3>
              <p class="text-sm text-slate-500 leading-relaxed flex-1">基于多维数据构建360度用户视图，精准识别高价值人群。</p>
            </div>

            <!-- 2. 销售预测 -->
            <div class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg bg-[#eff6ff] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">销售预测与预警</h3>
              <p class="text-sm text-slate-500 leading-relaxed flex-1">AI算法预测未来销量趋势，提前识别异常波动风险。</p>
            </div>

            <!-- 3. 流失挽回 -->
            <div class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg bg-[#eff6ff] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">流失挽回模型</h3>
              <p class="text-sm text-slate-500 leading-relaxed flex-1">精准定位潜在流失客户，生成个性化挽留策略。</p>
            </div>

            <!-- 4. 价格弹性 -->
            <div class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg bg-[#eff6ff] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">价格弹性分析</h3>
              <p class="text-sm text-slate-500 leading-relaxed flex-1">量化价格变动对销量的影响，寻找利润最大化平衡点。</p>
            </div>

            <!-- 5. 舆情洞察 -->
            <div class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg bg-[#eff6ff] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">舆情与口碑洞察</h3>
              <p class="text-sm text-slate-500 leading-relaxed flex-1">全网声量实时监控，从非结构化文本中提取品牌情绪。</p>
            </div>

            <!-- 6. 供应链优化 -->
            <div class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 flex flex-col h-full">
              <div class="w-12 h-12 rounded-lg bg-[#eff6ff] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">供应链优化</h3>
              <p class="text-sm text-slate-500 leading-relaxed flex-1">通过需求预测反向指导库存管理，降低周转成本。</p>
            </div>

             <!-- 补充一个占位或者放“定制化服务”让布局更平衡，或者直接留白 -->
             <div class="hidden lg:flex group bg-slate-100/50 rounded-xl p-6 border border-dashed border-slate-300 flex-col items-center justify-center text-center h-full cursor-pointer hover:bg-slate-100 transition-colors">
                <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center mb-3 shadow-sm">
                  <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                </div>
                <h3 class="text-base font-bold text-slate-600">更多定制服务</h3>
                <p class="text-xs text-slate-400 mt-1">联系我们获取方案</p>
             </div>

          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="py-16 bg-white dark:bg-gray-900 text-center">
        <div class="max-w-3xl mx-auto px-6 fade-in-up delay-300">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">准备好挖掘您的数据金矿了吗？</h2>
          <p class="text-slate-600 dark:text-slate-400 mb-8">我们的数据专家团队将在24小时内与您联系。</p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 text-base font-medium text-white rounded-lg shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5" style={`background-color: ${THEME_COLOR}`}>
            预约专家诊断
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </section>

    </main>

    <Footer />
    <BackToTop />
  </body>
</html>