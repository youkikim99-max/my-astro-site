---
// src/pages/apply.astro
import BaseLayout from '../layouts/BaseLayout.astro';

// 处理表单提交（Astro 原生支持）
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const name = formData.get('name');
  const email = formData.get('email');
  
  // 打印到控制台，方便测试（后续可接入 Formspree、Netlify Forms 或你们的后端 API）
  console.log('🚀 收到新的实验室申请:', { 
    name, 
    email, 
    role: formData.get('role'),
    portfolio: formData.get('portfolio'),
    motivation: formData.get('motivation')
  });
}
---

<BaseLayout title="加入创新实验室 | Usearch">
  <section class="apply-page">
    <div class="container">
      <div class="form-card">
        <!-- 表单头部 -->
        <div class="form-header">
          <div class="eyebrow">USEARCH · 创新实验室</div>
          <h1>申请加入「创新实验室」</h1>
          <p>请填写以下信息，让我们了解你的技能栈与热情。审核通过后，我们将在 3 个工作日内与你联系。</p>
        </div>

        <!-- 表单主体 -->
        <form method="POST" class="form-body">
          <div class="form-grid">
            <div class="form-group">
              <label for="name">姓名 *</label>
              <input type="text" id="name" name="name" required placeholder="你的真实姓名" />
            </div>
            <div class="form-group">
              <label for="email">邮箱 *</label>
              <input type="email" id="email" name="email" required placeholder="example@email.com" />
            </div>
            <div class="form-group">
              <label for="role">你的主要角色 *</label>
              <select id="role" name="role" required>
                <option value="" disabled selected>请选择...</option>
                <option value="pm">产品经理 / 设计师</option>
                <option value="dev">前端 / 后端 / 全栈开发</option>
                <option value="data">数据分析师 / AI 算法</option>
                <option value="other">其他 / 跨界探索者</option>
              </select>
            </div>
            <div class="form-group">
              <label for="portfolio">作品集 / GitHub 链接</label>
              <input type="url" id="portfolio" name="portfolio" placeholder="https://..." />
            </div>
          </div>

          <div class="form-group full-width">
            <label for="motivation">为什么想加入创新实验室？ *</label>
            <textarea id="motivation" name="motivation" rows="4" required placeholder="聊聊你最感兴趣的技术方向，或者你最近在做的项目..."></textarea>
          </div>

          <button type="submit" class="submit-btn">提交申请</button>
        </form>
      </div>
    </div>
  </section>

  <style>
    .container { max-width: 720px; margin: 0 auto; padding: 80px 24px; }
    
    .form-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08);
      padding: 48px;
    }
    
    .form-header { margin-bottom: 36px; }
    .eyebrow {
      font-size: 0.875rem;
      font-weight: 600;
      color: #2563EB; /* 品牌蓝 */
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .form-header h1 { 
      font-size: 2rem; 
      font-weight: 800; 
      color: #111827; 
      margin-bottom: 12px; 
    }
    .form-header p { 
      font-size: 1rem; 
      color: #6B7280; 
      line-height: 1.6; 
    }
    
    .form-grid { 
      display: grid; 
      grid-template-columns: 1fr 1fr; 
      gap: 20px; 
      margin-bottom: 20px; 
    }
    .form-group { 
      display: flex; 
      flex-direction: column; 
      gap: 8px; 
    }
    .form-group.full-width { margin-bottom: 24px; }
    
    label { 
      font-size: 0.875rem; 
      font-weight: 600; 
      color: #374151; 
    }
    
    input, select, textarea {
      padding: 12px 16px;
      border: 1px solid #D1D5DB;
      border-radius: 8px;
      font-size: 1rem;
      outline: none;
      transition: all 0.2s;
      background-color: #F9FAFB;
      font-family: inherit;
    }
    
    input:focus, select:focus, textarea:focus { 
      border-color: #2563EB; 
      background-color: #fff; 
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }
    
    .submit-btn {
      width: 100%;
      padding: 16px;
      background-color: #2563EB;
      color: white;
      font-size: 1rem;
      font-weight: 700;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
    }
    .submit-btn:hover { 
      background-color: #1D4ED8; 
      transform: translateY(-2px);
    }

    /* 响应式适配 */
    @media (max-width: 640px) {
      .form-grid { grid-template-columns: 1fr; }
      .form-card { padding: 32px 24px; }
      .form-header h1 { font-size: 1.75rem; }
    }
  </style>
</BaseLayout>