                <div class="text-3xl lg:text-4xl font-black text-blue-900 mb-2 tracking-tight">
                  200<span class="text-lg text-blue-700 font-bold ml-1">+</span>
                </div>
                <div class="text-sm md:text-base font-medium text-slate-600">万用户/专家数据库</div>
              </div>

              <!-- 卡片 3 -->
              <div class="bg-slate-50 p-6 md:p-8 rounded-2xl border border-slate-100 text-center hover:border-blue-200 hover:shadow-md transition-all duration-300 flex flex-col justify-center items-center h-full">
