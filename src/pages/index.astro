              <!-- 卡片 4 -->
              <div class="bg-slate-50 p-6 md:p-8 rounded-2xl border border-slate-100 text-center hover:border-blue-200 hover:shadow-md transition-all duration-300 flex flex-col justify-center items-center h-full">
