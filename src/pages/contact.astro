---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// 定义联系人数据
const contacts = [
  {
    name: 'Shirley',
    role: '管理咨询',
    phone: '18911128782',
    initial: 'S'
  },
  {
    name: 'Lucy',
    role: '市场调研',
    phone: '13522663782',
    initial: 'L'
  },
  {
    name: 'Elaine',
    role: '数据业务',
    phone: '13522116982',
    initial: 'E'
  }
];

const companyPhone = '010-85150202';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`联系我们 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      /* 简单的自定义样式，确保字体和间距完美 */
      .contact-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .contact-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50 text-slate-800 dark:bg-gray-950 dark:text-gray-100">
    <Header />

    <main class="flex-1 w-full py-20 md:py-32 px-4">
      <div class="max-w-6xl mx-auto">
        
        <!-- 顶部标题区 -->
        <div class="text-center mb-16">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-8 tracking-tight">
            联系我们
          </h1>
          
          <div class="inline-flex items-center bg-white dark:bg-gray-900 px-6 py-3 rounded-full shadow-sm border border-slate-100 dark:border-gray-800">
            <span class="text-slate-500 dark:text-slate-400 mr-3 text-lg">公司总机：</span>
            <a href={`tel:${companyPhone}`} class="text-xl font-bold text-blue-600 hover:text-blue-700 transition-colors">
              {companyPhone}
            </a>
          </div>
        </div>

        <!-- 人员卡片网格 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {contacts.map((person) => (
            <div class="contact-card bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] border border-slate-100 dark:border-gray-800 flex flex-col items-center text-center">
              
              {/* 头像区域 (首字母) */}
              <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-gray-800 flex items-center justify-center mb-6">
                <span class="text-2xl font-bold text-slate-700 dark:text-slate-200">{person.initial}</span>
              </div>

              {/* 职位/业务 */}
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium mb-2 uppercase tracking-wide">
                {person.role}
              </p>

              {/* 姓名 */}
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6">
                {person.name}
              </h3>

              {/* 电话号码 (蓝色高亮) */}
              <a href={`tel:${person.phone}`} class="text-lg font-bold text-blue-600 hover:text-blue-700 transition-colors block mb-2">
                {person.phone}
              </a>

              {/* 微信提示 */}
              <span class="text-xs text-slate-400 dark:text-slate-500">
                (微信同号)
              </span>

            </div>
          ))}
        </div>

      </div>
    </main>

    <Footer />
    <BackToTop />
  </body>
</html>